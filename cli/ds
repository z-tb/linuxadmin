#!/bin/bash

# Fancy Directory Size Reporter
# Usage: ./dirsize.sh [options] [path]
# Lists all subdirectories with their human-readable size in a consistent vertical layout.

# -------------------------
# Color definitions
# -------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# Unicode symbols
FOLDER_ICON="📁"
SIZE_ICON="💾"
ERROR_ICON="❌"
SUCCESS_ICON="✅"

# -------------------------
# Print header with fancy colors
# -------------------------
print_header() {
    echo -e "${BOLD}${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║${WHITE}          ${FOLDER_ICON}  DIRECTORY SPACE USAGE REPORT ${SIZE_ICON}                 ${CYAN}║${NC}"
    echo -e "${BOLD}${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo
}

# -------------------------
# Format sizes with color based on unit
# -------------------------
format_size() {
    local size=$1
    local unit=${size: -1}       # last character, e.g., K/M/G
    local number=${size%?}       # numeric part

    case $unit in
        'K') echo -e "${GREEN}${size}${NC}" ;;
        'M') echo -e "${YELLOW}${size}${NC}" ;;
        'G') echo -e "${MAGENTA}${size}${NC}" ;;
        'T') echo -e "${RED}${BOLD}${size}${NC}" ;;
        *)   echo -e "${BLUE}${size}${NC}" ;;
    esac
}

# -------------------------
# Display usage information
# -------------------------
show_usage() {
    cat << EOF
${BOLD}${WHITE}Usage:${NC} $(basename "$0") [OPTIONS] [DIRECTORY]

${BOLD}${WHITE}OPTIONS:${NC}
  -s, --sort-size      Sort by directory size (default)
  -n, --sort-name      Sort by directory name
  -d, --sort-date      Sort by modification date
  -r, --reverse        Reverse sort order
  -h, --help           Show this help message

${BOLD}${WHITE}EXAMPLES:${NC}
  $(basename "$0")                    # Current directory, sorted by size
  $(basename "$0") -n /home          # Sort by name
  $(basename "$0") -s -r /var        # Sort by size, largest first
  $(basename "$0") --sort-date       # Sort by modification date
EOF
}

# -------------------------
# Parse command line arguments
# -------------------------
parse_args() {
    SORT_BY="size"     # Default sort
    REVERSE_SORT=false
    TARGET_DIR="."

    while [[ $# -gt 0 ]]; do
        case $1 in
            -s|--sort-size) SORT_BY="size"; shift ;;
            -n|--sort-name) SORT_BY="name"; shift ;;
            -d|--sort-date) SORT_BY="date"; shift ;;
            -r|--reverse) REVERSE_SORT=true; shift ;;
            -h|--help) show_usage; exit 0 ;;
            -*)
                echo -e "${ERROR_ICON} ${RED}Unknown option: $1${NC}" >&2
                show_usage >&2
                exit 1
                ;;
            *) TARGET_DIR="$1"; shift ;;
        esac
    done
}

# -------------------------
# Validate target directory
# -------------------------
validate_directory() {
    local target_dir="$1"

    if [[ ! -e "$target_dir" ]]; then
        echo -e "${ERROR_ICON} ${RED}Error: Directory '${target_dir}' does not exist.${NC}" >&2
        exit 1
    fi

    if [[ ! -d "$target_dir" ]]; then
        echo -e "${ERROR_ICON} ${RED}Error: '${target_dir}' is not a directory.${NC}" >&2
        exit 1
    fi

    if [[ ! -r "$target_dir" ]]; then
        echo -e "${ERROR_ICON} ${RED}Error: Directory '${target_dir}' is not readable.${NC}" >&2
        exit 1
    fi

    echo "$target_dir"
}

# -------------------------
# Main script execution
# -------------------------
main() {
    parse_args "$@"
    TARGET_DIR=$(validate_directory "$TARGET_DIR")

    print_header

    echo -e "${DIM}Scanning directory:${NC} ${BOLD}${BLUE}$(realpath "$TARGET_DIR")${NC}"
    echo -e "${DIM}Sort method:${NC} ${WHITE}${SORT_BY}${NC} ${DIM}($([ "$REVERSE_SORT" = true ] && echo "descending" || echo "ascending"))${NC}"
    echo

    # Header for the table
    printf "${BOLD}%s %10s  %s${NC}\n" "DIR" "SIZE" "PATH"
    echo -e "${DIM}$(printf '%.0s─' {1..67})${NC}"

    # Temp files for sorting
    local temp_file=$(mktemp)
    local sorted_file=$(mktemp)

    # Collect directory info
    local total_dirs=0
    local total_size_kb=0

    while IFS= read -r -d '' dir; do
        if [[ "$dir" == "$TARGET_DIR" ]]; then continue; fi

        local size_output size_kb dir_name mod_date
        size_output=$(du -sh "$dir" 2>/dev/null | cut -f1)
        size_kb=$(du -sk "$dir" 2>/dev/null | cut -f1)
        dir_name="${dir#$TARGET_DIR/}"
        [[ "$dir_name" == "$dir" ]] && dir_name="$(basename "$dir")"
        mod_date=$(stat -c %Y "$dir" 2>/dev/null || echo "0")

        echo "${size_kb}|${dir_name}|${size_output}|${mod_date}" >> "$temp_file"

        ((total_dirs++))
        [[ -n "$size_kb" ]] && total_size_kb=$((total_size_kb + size_kb))
    done < <(find "$TARGET_DIR" -maxdepth 1 -type d -print0)

    # Sorting logic
    case "$SORT_BY" in
        "size") sort_cmd="sort -t'|' -k1,1n" ;;
        "name") sort_cmd="sort -t'|' -k2,2" ;;
        "date") sort_cmd="sort -t'|' -k4,4n" ;;
    esac

    [[ "$REVERSE_SORT" == "true" ]] && sort_cmd="$sort_cmd -r"
    eval "$sort_cmd" "$temp_file" > "$sorted_file"

    # Print sorted results with folder icon, size, and path aligned
    while IFS='|' read -r size_kb dir_name size_human mod_date; do
        printf "${CYAN}${FOLDER_ICON} %-16s %s${NC}\n" "$(format_size "$size_human")" "$dir_name/"
    done < "$sorted_file"

    # Cleanup
    rm -f "$temp_file" "$sorted_file"

    # Summary
    echo -e "${DIM}$(printf '%.0s─' {1..67})${NC}"

    if [[ $total_dirs -eq 0 ]]; then
        echo -e "${YELLOW}No subdirectories found.${NC}"
    else
        local total_human
        total_human=$(numfmt --to=iec --suffix=B $((total_size_kb * 1024)) 2>/dev/null || echo "${total_size_kb}K")
        total_human=${total_human%B}  # Remove 'B'

        printf "${BOLD}${WHITE}TOTAL: %d directories${NC} %28s\n" "$total_dirs" "$(format_size "$total_human")"
    fi

    echo
    echo -e "${SUCCESS_ICON} ${GREEN}Directory scan completed successfully!${NC}"
}

# Run script
main "$@"
