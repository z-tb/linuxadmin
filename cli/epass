#!/usr/bin/env python3
# ==============================================================================
# SCRIPT: epass
# DESCRIPTION:
#   An secret management utility designed to parse raw configuration blocks or environment 
#   variables and securely commit them as multi-line shell-export blocks into 'gopass'
#   using GPG encryption (`gopass@local`).  This utility was developed with containerized
#   AI workflows in mind where leaking credentials via cut/paste becomes more likely with
#   no great way to mitigate.  This utility allows for a single paste operation that
#   eliminates leaking secrets through plaintext files, shell history or terminal output
#   and scrollback. The secrets are stored in encrypted storeage using a temporary key
#   that both cease to exist when the container exits.
#
#   It auto-detects common cloud providers (e.g., AWS, GCP, Azure, GitHub) or lets
#   you provision custom, freeform top-level directories, organized under a 
#   chosen target environment namespace (dev/prod/test).
#
# REQUIREMENTS:
#   - Python 3.x
#   - GnuPG (`gpg`, `gpg-agent`, `gpgconf`)
#   - 'gopass' (The Next-Generation Password Manager binary) installed and accessible.
#
# USAGE INSTRUCTIONS:
#   1. Execute the tool: ./epass [OPTIONS]
#   2. Paste your lines formatted as raw `KEY=VALUE` or standard shell `export KEY="VALUE"`.
#   3. Finalize the stream paste capture by issuing: Enter -> Ctrl+D
#   4. Choose your structural folder routing and target environment when prompted.
#   5. Evaluate secrets in your shell using the companion `eload <path>` function.
#
# OPTIONS:
#   -h, --help        Display custom help menu showing stored credential paths.
#   --init            Install epass shell helpers (`eload`, `ezap`, `elist`, etc.)
#                     into ~/.epassrc and link them to ~/.bashrc or ~/.zshrc.
#   --reset           Wipe local gopass stores and delete the `gopass@local` GPG keypair.
#   --ttl HOURS       Inactivity passphrase cache timeout in hours (default: 1.0).
#   --max-ttl HOURS   Maximum passphrase cache timeout in hours (default: 24.0).
#
# NOTE:
#   Abort input processing cleanly at any stage by issuing Ctrl+C or ESC.
#   Age encryption might be nicer but doesn't allow for gpg-style caching of the secret
#   which may or may not be desired.
# ==============================================================================

import re
import sys
import termios
import tty
import subprocess
import os
import shutil
import argparse
import getpass

VALID_KEY = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')


